{
  "name": "loremfa",
  "displayName": "LoremFA",
  "description": "Type loremfa and press Tab to insert Persian placeholder text: loremfa for a paragraph, loremfa12 for 12 words, loremfa*2 for 2 paragraphs.",
  "version": "0.1.0",
  "license": "MIT",
  "categories": ["Snippets"],
  "keywords": ["lorem", "lorem ipsum", "persian", "farsi", "placeholder", "snippet"],
  "homepage": "https://loremfa.ir",
  "repository": {
    "type": "git",
    "url": "https://github.com/hashemidesign/loremfa-snippet.git"
  },
  "bugs": {
    "url": "https://github.com/hashemidesign/loremfa-snippet/issues"
  },
  "engines": { "vscode": "^1.74.0" },
  "main": "./extension.js",
  "icon": "images/icon.png",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [{ "command": "loremfa.expand", "title": "LoremFA: Expand Abbreviation" }],
    "keybindings": [{
      "key": "tab",
      "command": "loremfa.expand",
      "when": "editorTextFocus && !editorReadonly && !editorTabMovesFocus && !inSnippetMode && loremfa.canExpand"
    }]
  }
}
